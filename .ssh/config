Match exec 'ssh-add -L | grep -q "$(cat ~/.ssh/id_ed25519.pub)" || age -d -i ~/.passage/identities ~/.ssh/id_ed25519.age | ssh-add -q -t 10 -'
     ControlMaster auto
     ControlPath /tmp/ssh-%r@%h:%p
     ControlPersist 60

     ServerAliveInterval 5

     IdentitiesOnly yes

Include .colima/ssh_config
Include config.local
